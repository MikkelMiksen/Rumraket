.upgrade-panel {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.upgrade-container {
    width: 320px;
    padding: 20px;
    background-color: rgb(30, 34, 44);
    border-radius: 12px;
}

.upgrade-title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(240, 240, 240);
    margin-bottom: 16px;
}

.upgrade-button {
    height: 56px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgb(46, 125, 200);
    border-width: 0;
    border-radius: 8px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.upgrade-button:hover {
    background-color: rgb(66, 150, 225);
}

.upgrade-button:active {
    background-color: rgb(30, 95, 160);
}
